{
  "name": "reframe-spike-terminal",
  "private": true,
  "version": "0.0.0",
  "description": "Phase 0 spike: claude in node-pty + xterm.js, headless serialize across windows, cross-window DnD, WinEvent hooks via koffi",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "auto": "electron . --spike-auto"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "koffi": "3.3.2",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "electron": "44.7.0"
  },
  "allowScripts": {
    "koffi@3.3.2": true,
    "node-pty@1.1.0": true
  }
}
